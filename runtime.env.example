# ============================================================================
# runtime.env — configuración de PRODUCCIÓN (NO subir a git; va en el VPS)
# Ubicación en el VPS: /opt/ambulancia/config/runtime.env  (chmod 600)
# Lo usan los servicios "db" y "backend" del docker-compose.produccion.yml
# ============================================================================

# --- Base de datos (contenedor MariaDB) ---
MARIADB_DATABASE=seme
MARIADB_USER=seme_user
MARIADB_PASSWORD=CAMBIA_ESTA_PASSWORD_DB
MARIADB_ROOT_PASSWORD=CAMBIA_ESTA_PASSWORD_ROOT

# --- Backend (Express + Prisma) ---
PORT=3001
# El host es "db" (nombre del servicio en el compose), NO localhost:
DATABASE_URL="mysql://seme_user:CAMBIA_ESTA_PASSWORD_DB@db:3306/seme"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRETO_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=8h
CORS_ORIGIN=https://ambulancia.columbiatcc.online

# Compatibilidad (por si el código lee DB_* además de DATABASE_URL):
DB_HOST=db
DB_PORT=3306
DB_USER=seme_user
DB_PASSWORD=CAMBIA_ESTA_PASSWORD_DB
DB_NAME=seme
