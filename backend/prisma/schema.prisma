generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model base {
  id                Int                 @id @default(autoincrement()) @db.UnsignedTinyInt
  nombre            String              @unique(map: "nombre") @db.VarChar(100)
  calle             String?             @db.VarChar(150)
  nro               String?             @db.VarChar(10)
  barrio            String?             @db.VarChar(100)
  ciudad            String?             @db.VarChar(100)
  referencia        String?             @db.VarChar(255)
  latitud           Decimal?            @db.Decimal(10, 7)
  longitud          Decimal?            @db.Decimal(10, 7)
  activa            Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.DateTime(0)
  updated_at        DateTime            @default(now()) @db.DateTime(0)
  rol_guardia_movil rol_guardia_movil[]
}

model canal_ingreso {
  id          Int         @id @default(autoincrement()) @db.UnsignedTinyInt
  nombre      String      @unique(map: "nombre") @db.VarChar(30)
  descripcion String?     @db.VarChar(150)
  activo      Boolean     @default(true)
  solicitud   solicitud[]
  llamada     llamada[]  
}

model condicion_paciente {
  id                   Int                    @id @default(autoincrement()) @db.UnsignedTinyInt
  nombre               String                 @unique(map: "nombre") @db.VarChar(20)
  activo               Boolean                @default(true)
  ref_cama_reiteracion ref_cama_reiteracion[]
  ref_cama_clinica     ref_cama_clinica[]
}

model emergencia_accidente {
  id                      Int                  @id @default(autoincrement())
  solicitud_emergencia_id Int                  @unique(map: "solicitud_emergencia_id")
  subtipo_accidente_id    Int                  @db.UnsignedTinyInt
  cantidad_heridos        Int?                 @db.UnsignedTinyInt
  solicitud_emergencia    solicitud_emergencia @relation(fields: [solicitud_emergencia_id], references: [id], onUpdate: Restrict, map: "fk_ea_solicitud_emergencia")
  subtipo_accidente       subtipo_accidente    @relation(fields: [subtipo_accidente_id], references: [id], onUpdate: Restrict, map: "fk_ea_subtipo")

  @@index([subtipo_accidente_id], map: "fk_ea_subtipo")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model emergencia_no_traumatica {
  id                       Int                   @id @default(autoincrement())
  solicitud_emergencia_id  Int                   @unique(map: "solicitud_emergencia_id")
  subtipo_no_traumatica_id Int                   @db.UnsignedTinyInt
  consciencia              Boolean?
  respira                  Boolean?
  pulso                    Boolean?
  hemorragias              Boolean?
  fracturas                Boolean?
  solicitud_emergencia     solicitud_emergencia  @relation(fields: [solicitud_emergencia_id], references: [id], onUpdate: Restrict, map: "fk_ent_solicitud_emergencia")
  subtipo_no_traumatica    subtipo_no_traumatica @relation(fields: [subtipo_no_traumatica_id], references: [id], onUpdate: Restrict, map: "fk_ent_subtipo")

  @@index([subtipo_no_traumatica_id], map: "fk_ent_subtipo")
}

model emergencia_traumatica {
  id                      Int                  @id @default(autoincrement())
  solicitud_emergencia_id Int                  @unique(map: "solicitud_emergencia_id")
  subtipo_traumatica_id   Int                  @db.UnsignedTinyInt
  cantidad_heridos        Int?                 @db.UnsignedTinyInt
  solicitud_emergencia    solicitud_emergencia @relation(fields: [solicitud_emergencia_id], references: [id], onUpdate: Restrict, map: "fk_et_solicitud_emergencia")
  subtipo_traumatica      subtipo_traumatica   @relation(fields: [subtipo_traumatica_id], references: [id], onUpdate: Restrict, map: "fk_et_subtipo")

  @@index([subtipo_traumatica_id], map: "fk_et_subtipo")
}

model estado_solicitud {
  id                                                                           Int                   @id @default(autoincrement()) @db.UnsignedTinyInt
  nombre                                                                       String                @unique(map: "nombre") @db.VarChar(30)
  descripcion                                                                  String?               @db.VarChar(150)
  activo                                                                       Boolean               @default(true)
  historial_solicitud_historial_solicitud_estado_anterior_idToestado_solicitud historial_solicitud[] @relation("historial_solicitud_estado_anterior_idToestado_solicitud")
  historial_solicitud_historial_solicitud_estado_nuevo_idToestado_solicitud    historial_solicitud[] @relation("historial_solicitud_estado_nuevo_idToestado_solicitud")
  solicitud                                                                    solicitud[]
}

model inotripicos {
  id                 Int             @id @default(autoincrement())
  solicitud_id       Int
  tipo_inotripico_id Int             @db.UnsignedTinyInt
  usuario_id         Int
  dosis              String?         @db.VarChar(100)
  goteo              String?         @db.VarChar(100)
  created_at         DateTime        @default(now()) @db.DateTime(0)
  solicitud          solicitud       @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_in_solicitud")
  tipo_inotripico    tipo_inotripico @relation(fields: [tipo_inotripico_id], references: [id], onUpdate: Restrict, map: "fk_in_tipo_inotripico")
  usuario            usuario         @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "fk_in_usuario")

  @@index([solicitud_id], map: "fk_in_solicitud")
  @@index([tipo_inotripico_id], map: "fk_in_tipo_inotripico")
  @@index([usuario_id], map: "fk_in_usuario")
}

model persona {
  id                                                    Int                @id @default(autoincrement())
  primer_nombre                                         String             @db.VarChar(100)
  segundo_nombre                                        String?            @db.VarChar(100)
  primer_apellido                                       String             @db.VarChar(100)
  segundo_apellido                                      String?            @db.VarChar(100)
  nro_documento                                         String             @db.VarChar(20)
  tipo_documento                                        Int                @db.UnsignedTinyInt
  sexo                                                  String             @db.Char(1)
  fecha_nacimiento                                      DateTime           @db.Date
  created_at                                            DateTime           @default(now()) @db.DateTime(0)
  updated_at                                            DateTime           @default(now()) @db.DateTime(0)
  cliente                                               cliente?
  contacto                                              contacto[]
  direccion                                             direccion[]
  paciente_dialisis                                     paciente_dialisis?
  tipo_documento_persona_tipo_documentoTotipo_documento tipo_documento     @relation("persona_tipo_documentoTotipo_documento", fields: [tipo_documento], references: [id], onUpdate: Restrict, map: "fk_persona_tipo_documento")
  solicitud                                             solicitud[]
  usuario                                               usuario?

  @@unique([nro_documento, tipo_documento], map: "uk_documento")
  @@index([tipo_documento], map: "fk_persona_tipo_documento")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model ref_cama_clinica {
  id                                                      Int           @id @default(autoincrement())
  solicitud_id                                            Int           @unique(map: "solicitud_id")
  hospital_origen_id                                      Int?
  hospital_destino_id                                     Int?
  tipo_paciente_id                                        Int           @db.UnsignedTinyInt
  peso                                                    Decimal?      @db.Decimal(6, 2)
  unidad_peso                                             String?       @db.VarChar(15)
  seguro_medico                                           String?       @db.VarChar(100)
  antecedentes                                            String?       @db.Text
  diagnostico                                             String        @db.Text
  tiempo_evolucion                                        String?       @db.VarChar(100)
  tiempo_internacion                                      String?       @db.VarChar(100)
  escala_dolor                                            Int?          @db.TinyInt
  laboratorio                                             String?       @db.Text
  imagenes                                                String?       @db.Text
  otros_datos                                             String?       @db.Text
  en_uti                  Boolean       @default(false)     // ¿internado en UTI? (Q28)
  tratamiento             String?       @db.Text            // tratamiento recibido (Q39)
  tipo_requerimiento_id   Int?          @db.UnsignedTinyInt // tipo de sala/cama requerida (Q27/Q29)
  condicion_id            Int?          @db.UnsignedTinyInt // ESTABLE / INESTABLE (Q38)
  hospital_ref_cama_clinica_hospital_destino_idTohospital hospital?     @relation("ref_cama_clinica_hospital_destino_idTohospital", fields: [hospital_destino_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rcc_destino")
  hospital_ref_cama_clinica_hospital_origen_idTohospital  hospital?     @relation("ref_cama_clinica_hospital_origen_idTohospital", fields: [hospital_origen_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rcc_origen")
  solicitud                                               solicitud     @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_rcc_solicitud")
  tipo_paciente                                           tipo_paciente @relation(fields: [tipo_paciente_id], references: [id], onUpdate: Restrict, map: "fk_rcc_tipo_paciente")
  tipo_requerimiento_cama                                 tipo_requerimiento_cama? @relation(fields: [tipo_requerimiento_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rcc_requerimiento")
  condicion_paciente                                      condicion_paciente?      @relation(fields: [condicion_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rcc_condicion")

  @@index([tipo_paciente_id], map: "fk_rcc_tipo_paciente")
  @@index([hospital_destino_id], map: "fk_rcc_destino")
  @@index([hospital_origen_id], map: "fk_rcc_origen")
  @@index([tipo_requerimiento_id], map: "fk_rcc_requerimiento")
  @@index([condicion_id], map: "fk_rcc_condicion")
}

model ref_cama_obstetrica {
  id                   Int       @id @default(autoincrement())
  solicitud_id         Int       @unique(map: "solicitud_id")
  edad_gestacional     String?   @db.VarChar(50)
  controles_prenatales Int?      @db.TinyInt
  edad_materna         Int?      @db.TinyInt
  via_parto            String?   @db.VarChar(15)
  apgar                String?   @db.VarChar(10)
  maduracion_pulmonar  String?   @db.Text
  solicitud            solicitud @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_rco_solicitud")
}

model ref_cama_reiteracion {
  id                      Int                     @id @default(autoincrement())
  solicitud_id            Int
  nro_reiteracion         Int                     @default(1) @db.UnsignedTinyInt
  tipo_requerimiento_id   Int                     @db.UnsignedTinyInt
  condicion_id            Int                     @db.UnsignedTinyInt
  en_uti                  Boolean                 @default(false)
  tratamiento             String?                 @db.Text
  observacion             String?                 @db.Text
  usuario_id              Int
  created_at              DateTime                @default(now()) @db.DateTime(0)
  condicion_paciente      condicion_paciente      @relation(fields: [condicion_id], references: [id], onUpdate: Restrict, map: "fk_rcr_condicion")
  tipo_requerimiento_cama tipo_requerimiento_cama @relation(fields: [tipo_requerimiento_id], references: [id], onUpdate: Restrict, map: "fk_rcr_requerimiento")
  solicitud               solicitud               @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_rcr_solicitud")
  usuario                 usuario                 @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "fk_rcr_usuario")
  signos_vitales          signos_vitales[]

  @@index([condicion_id], map: "fk_rcr_condicion")
  @@index([tipo_requerimiento_id], map: "fk_rcr_requerimiento")
  @@index([solicitud_id], map: "fk_rcr_solicitud")
  @@index([usuario_id], map: "fk_rcr_usuario")
}

model rol {
  id          Int       @id @default(autoincrement()) @db.UnsignedTinyInt
  nombre      String    @unique(map: "nombre") @db.VarChar(50)
  descripcion String?   @db.VarChar(200)
  usuario     usuario[]
}

model rol_guardia {
  id                       Int                        @id @default(autoincrement())
  codigo                   String                     @unique(map: "codigo") @db.VarChar(20)
  tipo                     String                     @default("TURNO_REGULAR") @db.VarChar(30)
  nombre                   String?                    @db.VarChar(150)
  coordinador_id           Int
  fecha_inicio             DateTime                   @db.DateTime(0)
  fecha_fin                DateTime                   @db.DateTime(0)
  estado                   String                     @default("PLANIFICADO") @db.VarChar(20)
  observacion              String?                    @db.Text
  created_at               DateTime                   @default(now()) @db.DateTime(0)
  updated_at               DateTime                   @default(now()) @db.DateTime(0)
  usuario                  usuario                    @relation(fields: [coordinador_id], references: [id], onUpdate: Restrict, map: "fk_rol_guardia_coordinador")
  rol_guardia_modificacion rol_guardia_modificacion[]
  rol_guardia_movil        rol_guardia_movil[]

  @@index([coordinador_id], map: "fk_rol_guardia_coordinador")
}

model rol_guardia_modificacion {
  id                 Int         @id @default(autoincrement())
  rol_guardia_id     Int
  usuario_id         Int
  descripcion        String      @db.Text
  fecha_modificacion DateTime    @default(now()) @db.DateTime(0)
  rol_guardia        rol_guardia @relation(fields: [rol_guardia_id], references: [id], onUpdate: Restrict, map: "fk_rgmod_rol_guardia")
  usuario            usuario     @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "fk_rgmod_usuario")

  @@index([rol_guardia_id], map: "fk_rgmod_rol_guardia")
  @@index([usuario_id], map: "fk_rgmod_usuario")
}

model rol_guardia_movil {
  id              Int             @id @default(autoincrement())
  rol_guardia_id  Int
  vehiculo_id     Int
  base_id         Int             @db.UnsignedTinyInt
  tipo_soporte_id Int             @db.UnsignedTinyInt
  estado          String          @default("DISPONIBLE") @db.VarChar(20)
  vigencia_inicio DateTime?       @db.DateTime(0)
  vigencia_fin    DateTime?       @db.DateTime(0)
  latitud         Decimal?        @db.Decimal(10, 7)
  longitud        Decimal?        @db.Decimal(10, 7)
  activo          Boolean         @default(true)
  created_at      DateTime        @default(now()) @db.DateTime(0)
  updated_at      DateTime        @default(now()) @db.DateTime(0)
  cobertura       cobertura[]
  despacho        despacho[]
  orden_trabajo   orden_trabajo[]
  base            base            @relation(fields: [base_id], references: [id], onUpdate: Restrict, map: "fk_rgm_base")
  rol_guardia     rol_guardia     @relation(fields: [rol_guardia_id], references: [id], onUpdate: Restrict, map: "fk_rgm_rol_guardia")
  tipo_soporte    tipo_soporte    @relation(fields: [tipo_soporte_id], references: [id], onUpdate: Restrict, map: "fk_rgm_tipo_soporte")
  movil           movil           @relation(fields: [vehiculo_id], references: [id], onUpdate: Restrict, map: "fk_rgm_vehiculo")
  tripulacion     tripulacion[]

  @@index([base_id], map: "fk_rgm_base")
  @@index([rol_guardia_id], map: "fk_rgm_rol_guardia")
  @@index([tipo_soporte_id], map: "fk_rgm_tipo_soporte")
  @@index([vehiculo_id], map: "fk_rgm_vehiculo")
}

model signos_vitales {
  id                      Int           @id @default(autoincrement())
  solicitud_id            Int
  ref_cama_reiteracion_id Int?
  presion_arterial        String?       @db.VarChar(20)
  frecuencia_cardiaca     String?       @db.VarChar(10)
  frecuencia_respiratoria String?       @db.VarChar(10)
  temperatura             Decimal?      @db.Decimal(5, 2)
  glasgow                 Int?          @db.TinyInt
  saturacion              String?       @db.VarChar(10)
  tipo_oxigeno_id         Int?          @db.UnsignedTinyInt
  oxigeno_flujo           Decimal?      @db.Decimal(5, 2)
  usuario_id              Int
  created_at              DateTime      @default(now()) @db.DateTime(0)
  solicitud               solicitud     @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_sv_solicitud")
  ref_cama_reiteracion    ref_cama_reiteracion? @relation(fields: [ref_cama_reiteracion_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sv_reiteracion")
  tipo_oxigeno            tipo_oxigeno? @relation(fields: [tipo_oxigeno_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sv_tipo_oxigeno")
  usuario                 usuario       @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "fk_sv_usuario")

  @@index([solicitud_id], map: "fk_sv_solicitud")
  @@index([ref_cama_reiteracion_id], map: "fk_sv_reiteracion")
  @@index([tipo_oxigeno_id], map: "fk_sv_tipo_oxigeno")
  @@index([usuario_id], map: "fk_sv_usuario")
}

model solicitud {
  id                      Int                       @id @default(autoincrement())
  tipo_solicitud_id       Int                       @db.UnsignedTinyInt
  tipo_servicio_id        Int?                      @db.UnsignedTinyInt
  estado_solicitud_id     Int                       @default(1) @db.UnsignedTinyInt
  canal_ingreso_id        Int                       @db.UnsignedTinyInt
  recepcionista_id        Int
  denunciante_nombre      String?                   @db.VarChar(200)
  denunciante_telefono    String?                    @db.VarChar(20)
  direccion               String?                   @db.VarChar(255)
  nro_casa                String?                   @db.VarChar(10)
  ciudad                  String?                   @db.VarChar(100)
  barrio                  String?                   @db.VarChar(100)
  latitud                 Decimal?                  @db.Decimal(10, 7)
  longitud                Decimal?                  @db.Decimal(10, 7)
  persona_id              Int?
  paciente_nombre         String?                   @db.VarChar(100)
  paciente_apellido       String?                   @db.VarChar(100)
  paciente_documento      String?                   @db.VarChar(20)
  paciente_edad           String?                   @db.VarChar(20)
  paciente_edad_unidad    String?                   @db.VarChar(15)
  paciente_sexo           String?                   @db.Char(1)
  prioridad               String?                   @db.VarChar(10)
  es_nn                   Boolean                   @default(false)
  observacion             String?                   @db.Text
regulacion_cama         regulacion_cama?
regulacion_llamada regulacion_llamada[]
  created_at              DateTime                  @default(now()) @db.DateTime(0)
  updated_at              DateTime                  @default(now()) @db.DateTime(0)
  auditoria               auditoria[]
  chatbot_confirmacion    chatbot_confirmacion[]
  cobertura               cobertura[]
  despacho                despacho[]
  llamada                 llamada[]  
  historial_solicitud     historial_solicitud[]
  inotripicos             inotripicos[]
  notificacion            notificacion[]
  orden_trabajo           orden_trabajo[]
  prioridad_log           prioridad_log[]
  ref_cama_clinica        ref_cama_clinica?
  ref_cama_obstetrica     ref_cama_obstetrica?
  ref_cama_reiteracion    ref_cama_reiteracion[]
  signos_vitales          signos_vitales[]
  canal_ingreso           canal_ingreso             @relation(fields: [canal_ingreso_id], references: [id], onUpdate: Restrict, map: "fk_sol_canal")
  estado_solicitud        estado_solicitud          @relation(fields: [estado_solicitud_id], references: [id], onUpdate: Restrict, map: "fk_sol_estado")
  persona                 persona?                  @relation(fields: [persona_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_sol_persona")
  usuario                 usuario                   @relation(fields: [recepcionista_id], references: [id], onUpdate: Restrict, map: "fk_sol_recepcionista")
  tipo_servicio           tipo_servicio?            @relation(fields: [tipo_servicio_id], references: [id], onUpdate: Restrict, map: "fk_sol_tipo_servicio")
  tipo_solicitud          tipo_solicitud            @relation(fields: [tipo_solicitud_id], references: [id], onUpdate: Restrict, map: "fk_sol_tipo_solicitud")
  solicitud_emergencia    solicitud_emergencia?
  emergencia_respuesta    emergencia_respuesta[]
  solicitud_ref_cama      solicitud_ref_cama?
  solicitud_traslado      solicitud_traslado?
  traslado_dialisis       traslado_dialisis?
  ficha_prehospitalaria   ficha_prehospitalaria[]
  traslado_requerimientos traslado_requerimientos[]

  @@index([canal_ingreso_id], map: "fk_sol_canal")
  @@index([estado_solicitud_id], map: "fk_sol_estado")
  @@index([persona_id], map: "fk_sol_persona")
  @@index([recepcionista_id], map: "fk_sol_recepcionista")
  @@index([tipo_servicio_id], map: "fk_sol_tipo_servicio")
  @@index([tipo_solicitud_id], map: "fk_sol_tipo_solicitud")
}

model ficha_prehospitalaria {
  id                 Int       @id @default(autoincrement())
  solicitud_id       Int
  nro_victima        Int       @default(1)
  paciente_documento String?   @db.VarChar(20)
  datos              String    @db.LongText
  firma_entrega      String?   @db.LongText
  firma_prestador    String?   @db.LongText
  cerrada            Boolean   @default(false)
  creado_por         Int
  created_at         DateTime  @default(now()) @db.DateTime(0)
  updated_at         DateTime  @default(now()) @db.DateTime(0)
  solicitud          solicitud @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_ficha_solicitud")
  usuario            usuario   @relation(fields: [creado_por], references: [id], onUpdate: Restrict, map: "fk_ficha_usuario")

  @@index([solicitud_id], map: "idx_ficha_solicitud")
  @@index([paciente_documento], map: "idx_ficha_ci")
  @@index([creado_por], map: "fk_ficha_usuario")
}
model solicitud_emergencia {
  id                       Int                       @id @default(autoincrement())
  solicitud_id             Int                       @unique(map: "solicitud_id")
  tipo_servicio_id         Int?                      @db.UnsignedTinyInt
  cantidad_heridos         Int?                      @db.UnsignedTinyInt
  motivo_consulta_id       Int?
  relato                   String?                   @db.Text
  prioridad_sugerida       String?                   @db.VarChar(10)
  prioridad_asignada       String?                   @db.VarChar(10)
  bnd_sin_conciencia       Boolean                   @default(false)
  bnd_sin_respiracion      Boolean                   @default(false)
  bnd_sin_pulso            Boolean                   @default(false)
  bnd_sangrado_masivo      Boolean                   @default(false)
  bnd_convulsionando       Boolean                   @default(false)
  bnd_dificultad_resp      Boolean                   @default(false)
  emergencia_accidente     emergencia_accidente?
  emergencia_no_traumatica emergencia_no_traumatica?
  emergencia_traumatica    emergencia_traumatica?
  solicitud                solicitud                 @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_se_solicitud")
  tipo_servicio            tipo_servicio?            @relation(fields: [tipo_servicio_id], references: [id], onUpdate: Restrict, map: "fk_se_tipo_servicio")
  motivo_consulta          motivo_consulta?          @relation(fields: [motivo_consulta_id], references: [id], onUpdate: Restrict, map: "fk_se_motivo")

  @@index([tipo_servicio_id], map: "fk_se_tipo_servicio")
  @@index([motivo_consulta_id], map: "fk_se_motivo")
}

