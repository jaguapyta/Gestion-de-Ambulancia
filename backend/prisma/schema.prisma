  condicion_cierre    condicion_cierre? @relation(fields: [condicion_cierre_id], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_rc_condicion_cierre")

  @@index([medico_id], map: "fk_rc_medico")
  @@index([condicion_cierre_id], map: "fk_rc_condicion_cierre")
}
model regulacion_llamada {
  id                Int       @id @default(autoincrement())
  solicitud_id      Int
  usuario_id        Int
  hospital_unidad   String    @db.VarChar(200)
  medico_contactado String?   @db.VarChar(200)
  telefono          String?   @db.VarChar(15)
  respuesta         String?   @db.Text
  created_at        DateTime  @default(now()) @db.DateTime(0)
  solicitud         solicitud @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_rll_solicitud")
  usuario           usuario   @relation(fields: [usuario_id], references: [id], onUpdate: Restrict, map: "fk_rll_usuario")

  @@index([solicitud_id], map: "fk_rll_solicitud")
  @@index([usuario_id], map: "fk_rll_usuario")
}
model motivo_consulta {
  id            Int                    @id @default(autoincrement())
  codigo        String                 @unique(map: "uk_motivo_codigo") @db.VarChar(10)
  nombre        String                 @db.VarChar(150)
  color         String                 @db.VarChar(10)   // ROJO | AMARILLO | VERDE | AZUL (color base)
  codigo_radial String?                @db.VarChar(15)   // 10.80, etc.
  nota_seguridad String?               @db.Text          // riesgos de escena / seguridad del personal
  activo        Boolean                @default(true)
  preguntas     motivo_pregunta[]
  instrucciones motivo_instruccion[]
  criterios     motivo_criterio[]
  sinonimos     motivo_sinonimo[]
  solicitud_emergencia solicitud_emergencia[]
}

model motivo_pregunta {
  id          Int             @id @default(autoincrement())
  motivo_id   Int
  orden       Int
  texto       String          @db.Text
  tipo_respuesta String       @default("SI_NO") @db.VarChar(10)  // SI_NO | TEXTO
  es_bandera   Boolean        @default(false)
  resp_alarma  String?        @db.VarChar(3)    // SI | NO : respuesta que dispara la alarma (legacy)
  color_alarma String         @default("ROJO") @db.VarChar(10)   // legacy
  color_si     String?        @db.VarChar(10)   // ROJO|AMARILLO|VERDE si la respuesta es SI
  color_no     String?        @db.VarChar(10)   // ROJO|AMARILLO|VERDE si la respuesta es NO
  motivo      motivo_consulta @relation(fields: [motivo_id], references: [id], onUpdate: Restrict, map: "fk_mp_motivo")
  respuestas  emergencia_respuesta[]

  @@index([motivo_id], map: "fk_mp_motivo")
}

model motivo_instruccion {
  id        Int             @id @default(autoincrement())
  motivo_id Int
  orden     Int
  texto     String          @db.Text
  motivo    motivo_consulta @relation(fields: [motivo_id], references: [id], onUpdate: Restrict, map: "fk_mi_motivo")

  @@index([motivo_id], map: "fk_mi_motivo")
}

model motivo_criterio {
  id        Int             @id @default(autoincrement())
  motivo_id Int
  color     String          @db.VarChar(10)   // ROJO | AMARILLO | VERDE
  criterio  String          @db.Text
  motivo    motivo_consulta @relation(fields: [motivo_id], references: [id], onUpdate: Restrict, map: "fk_mc_motivo")

  @@index([motivo_id], map: "fk_mc_motivo")
}

model motivo_sinonimo {
  id               Int             @id @default(autoincrement())
  motivo_id        Int
  texto            String          @db.VarChar(150)
  origen           String          @default("MANUAL") @db.VarChar(10)   // SEED | MANUAL | IA
  estado           String          @default("APROBADO") @db.VarChar(10) // PENDIENTE | APROBADO | RECHAZADO
  activo           Boolean         @default(true)
  creado_por       Int?
  aprobado_por     Int?
  fecha_aprobacion DateTime?       @db.DateTime(0)
  contexto         String?         @db.VarChar(255)   // relato/texto del llamante que originó la propuesta
  created_at       DateTime        @default(now()) @db.DateTime(0)
  motivo           motivo_consulta @relation(fields: [motivo_id], references: [id], onUpdate: Restrict, map: "fk_ms_motivo")

  @@index([motivo_id], map: "fk_ms_motivo")
  @@index([estado], map: "idx_ms_estado")
}
model emergencia_respuesta {
  id                Int             @id @default(autoincrement())
  solicitud_id      Int
  motivo_pregunta_id Int
  respuesta         String          @db.VarChar(10)   // SI | NO | NO_SABE
  created_at        DateTime        @default(now()) @db.DateTime(0)
  solicitud         solicitud       @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_er_solicitud")
  motivo_pregunta   motivo_pregunta @relation(fields: [motivo_pregunta_id], references: [id], onUpdate: Restrict, map: "fk_er_pregunta")

  @@index([solicitud_id], map: "fk_er_solicitud")
  @@index([motivo_pregunta_id], map: "fk_er_pregunta")
}
// Cada comunicación entrante. Un incidente (solicitud) puede tener varias llamadas
// (p. ej. varios testigos del mismo hecho). La principal es la que originó el incidente.
model llamada {
  id                   Int           @id @default(autoincrement())
  solicitud_id         Int
  recepcionista_id     Int
  canal_ingreso_id     Int           @db.UnsignedTinyInt
  denunciante_nombre   String?       @db.VarChar(200)
  denunciante_telefono String?       @db.VarChar(20)
  relato               String?       @db.Text
  es_principal         Boolean       @default(false)
  created_at           DateTime      @default(now()) @db.DateTime(0)
  solicitud            solicitud     @relation(fields: [solicitud_id], references: [id], onUpdate: Restrict, map: "fk_llamada_solicitud")
  canal_ingreso        canal_ingreso @relation(fields: [canal_ingreso_id], references: [id], onUpdate: Restrict, map: "fk_llamada_canal")
  usuario              usuario       @relation(fields: [recepcionista_id], references: [id], onUpdate: Restrict, map: "fk_llamada_recepcionista")

  @@index([solicitud_id], map: "idx_llamada_solicitud")
  @@index([canal_ingreso_id], map: "fk_llamada_canal")
  @@index([recepcionista_id], map: "fk_llamada_recepcionista")
}